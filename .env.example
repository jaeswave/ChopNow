VITE_API_URL=http://localhost:3000
# Optional test-version ribbon shown at the top of every page. Leave empty for a normal launch.
VITE_BETA_NOTICE=
# Coming soon mode: "true" shows visitors and buyers a coming soon home page with a waitlist, and hides deals.
# Sellers and admins still see everything. Leave empty (or anything but "true") for the normal site.
VITE_COMING_SOON=
# Preview unlock for coming soon mode: a word. Opening any page with ?preview=<word> shows that browser the full site.
# A soft lock, NOT security: like every VITE_ value it is visible in the public website code. Empty: off.
VITE_PREVIEW_CODE=
